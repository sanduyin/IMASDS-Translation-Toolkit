# 忽略所有游戏原版ROM、解包数据和生成的补丁ROM
game_data/

# 忽略 Python 的运行缓存
__pycache__/
*.py[cod]
*$py.class

# 忽略测试覆盖率报告
.coverage
coverage.xml
htmlcov/

# 忽略性能基准结果（每次运行生成，不入库）
benchmarks/results/

# 忽略系统自动生成的缩略图缓存等
.DS_Store
Thumbs.db
*.otf
*.xlsx
/workspace
*.NFTR

# 忽略临时测试脚本和诊断输出（不入库）
_test_*.py
_audit_*.py
_compare_*.py
_probe_*.py
_diag_*.out
_diag_*.txt
_scout_*.txt
_tmp_verify/
